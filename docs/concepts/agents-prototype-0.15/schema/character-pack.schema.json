              },
              "parts": {
                "type": "object",
                "properties": {
                  "head": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,159}$",
                    "description": "Expected a stable ID (letters, digits, dots, hyphens or underscores; up to 160 characters)."
                  },
                  "body": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,159}$",
                    "description": "Expected a stable ID (letters, digits, dots, hyphens or underscores; up to 160 characters)."
                  },
                  "ears": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,159}$",
                    "description": "Expected a stable ID (letters, digits, dots, hyphens or underscores; up to 160 characters)."
                  },
                  "tail": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,159}$",
                    "description": "Expected a stable ID (letters, digits, dots, hyphens or underscores; up to 160 characters)."
                  },
                  "arms": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,159}$",
                    "description": "Expected a stable ID (letters, digits, dots, hyphens or underscores; up to 160 characters)."
                  },
                  "screen": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,159}$",
                    "description": "Expected a stable ID (letters, digits, dots, hyphens or underscores; up to 160 characters)."
                  },
                  "base": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,159}$",
                    "description": "Expected a stable ID (letters, digits, dots, hyphens or underscores; up to 160 characters)."
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "scale": {
                "type": "number",
                "minimum": 0.75,
                "maximum": 1.3
              },
              "pose": {
                "type": "string",
                "enum": [
                  "neutral",
                  "ready",
                  "wave",
                  "thinking",
                  "working",
                  "celebrate"
                ]
              },
              "teamNickname": {
                "type": "string",
                "maxLength": 100000
              },
              "greeting": {
                "type": "string",
                "maxLength": 100000
              },
              "motto": {
                "type": "string",
                "maxLength": 100000
              },
              "favoriteSymbol": {
                "type": "string",
                "maxLength": 100000
              }
            },
            "required": [
              "primaryColor",
              "secondaryColor",
              "accentColor",
              "eyeStyle",
              "expression",
              "idleStyle",
              "pattern",
              "finish",
              "accessoryIds",
              "category",
              "modelId",
              "parts",
              "scale",
              "pose",
              "teamNickname",
              "greeting",
              "motto",
              "favoriteSymbol"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "appearance"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "author",
    "builtIn",
    "modelIds",
    "partIds",
    "stylePresetIds",
    "savedLooks"
  ],
  "additionalProperties": false
}
