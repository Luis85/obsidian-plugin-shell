{
  "name": "obsidian-agents-klaus-editor-prototype",
  "private": true,
  "version": "0.15.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "test:architecture": "node scripts/architecture-check.mjs",
    "test:core": "node scripts/run-core-tests.mjs",
    "check": "npm run check:core && npm run test:templates && npm run typecheck && npm test && npm run build",
    "preview": "vite preview",
    "test:syntax": "node scripts/syntax-check.mjs",
    "test:contracts": "node scripts/static-contracts.mjs",
    "schema:generate": "node scripts/build-schemas.mjs",
    "schema:check": "node scripts/build-schemas.mjs --check",
    "check:core": "npm run test:architecture && npm run test:syntax && npm run test:contracts && npm run schema:check && npm run test:core",
    "test:templates": "node scripts/check-vue-templates.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.2",
    "pinia": "^3.0.0",
    "three": "^0.180.0",
    "vue": "^3.5.43",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.0.0"
  }
}
