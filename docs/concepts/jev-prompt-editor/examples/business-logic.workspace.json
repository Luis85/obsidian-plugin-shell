  "logic": {
    "kind": "jev-logic",
    "schemaVersion": 1,
    "rules": [
      {
        "id": "routing_policy",
        "name": "Route only clear project notes",
        "description": "First matching branch wins. Uncertain or fallback classifications require review.",
        "status": "draft",
        "events": [
          {
            "id": "decision_made",
            "name": "routing.decided",
            "description": "The rule made a deterministic decision from the supplied evidence.",
            "when": "completed",
            "fields": [
              {
                "name": "code",
                "type": "string",
                "required": true,
                "description": ""
              }
            ],
            "payload": [
              {
                "name": "code",
                "binding": {
                  "mode": "path",
                  "value": "output.decision.code",
                  "amount": 1
                }
              }
            ]
          }
        ],
        "mode": "if",
        "inputs": [
          {
            "name": "answers",
            "type": "object",
            "required": true,
            "description": ""
          }
        ],
        "branches": [
          {
            "id": "accepted",
            "name": "Confident project decision",
            "match": "all",
            "conditions": [
              {
                "id": "confidence",
                "left": {
                  "mode": "path",
                  "value": "input.answers.destination.confidence",
                  "amount": 1
                },
                "operator": "gte",
                "right": {
                  "mode": "literal",
                  "value": "0.85",
                  "amount": 1
                }
              },
              {
                "id": "destination",
                "left": {
                  "mode": "path",
                  "value": "input.answers.destination.choice",
                  "amount": 1
                },
                "operator": "eq",
                "right": {
                  "mode": "literal",
                  "value": "\"project\"",
                  "amount": 1
                }
              }
            ],
            "decision": {
              "type": "process",
              "code": "prepare_task",
              "processId": "prepare_task"
            }
          }
        ],
        "fallback": {
          "type": "review",
          "code": "needs_review",
          "processId": ""
        },
        "maxIterations": 5
      },
      {
        "id": "bounded_retry",
        "name": "Repeat while attempts remain",
        "description": "Evaluate typed evidence, then return an explicit decision.",
        "status": "draft",
        "events": [],
        "mode": "while",
        "inputs": [
          {
            "name": "attempt",
            "type": "number",
            "required": true,
            "description": ""
          }
        ],
        "branches": [
          {
            "id": "repeat",
            "name": "Attempt is below 3",
            "match": "all",
            "conditions": [
              {
                "id": "remaining",
                "left": {
                  "mode": "path",
                  "value": "input.attempt",
                  "amount": 1
                },
                "operator": "lt",
                "right": {
                  "mode": "literal",
                  "value": "3",
                  "amount": 1
                }
              }
            ],
            "decision": {
              "type": "process",
              "code": "next_attempt",
              "processId": "increment_attempt"
            }
          }
        ],
        "fallback": {
          "type": "continue",
          "code": "finished",
          "processId": ""
        },
        "maxIterations": 5
      }
    ],
