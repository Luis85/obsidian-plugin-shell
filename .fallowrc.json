  "plugins": [
    "scripts/quality/fallow-node-tests.json"
  ],
  "ignorePatterns": [
    "dist-harness/**",
    "reports/**"
  ],
  "boundaries": {
    "coverage": {
      "requireAllFiles": true
    },
    "zones": [
      {
        "name": "domain",
        "patterns": [
          "src/domain/**"
        ]
      },
      {
        "name": "application",
        "patterns": [
          "src/application/**"
        ]
      },
      {
        "name": "features",
        "patterns": [
          "src/features/**"
        ]
      },
      {
        "name": "infrastructure",
        "patterns": [
          "src/infrastructure/**"
        ]
      },
      {
        "name": "presentation",
        "patterns": [
          "src/presentation/**"
        ]
      },
      {
        "name": "bootstrap",
        "patterns": [
          "src/bootstrap/**",
          "src/main.ts"
        ]
      },
      {
        "name": "test",
        "patterns": [
          "tests/**"
        ]
      },
      {
        "name": "harness",
        "patterns": [
          "harness/**"
        ]
      },
      {
        "name": "tooling",
        "patterns": [
          "scripts/**",
          "*.config.*"
        ]
      },
      {
        "name": "styles",
        "patterns": [
          "src/styles/**"
        ]
      },
      {
        "name": "companion-concept",
        "patterns": [
          "docs/concepts/companion/src/**",
          "docs/concepts/companion/vendor/**"
        ]
      }
    ],
    "rules": [
      {
        "from": "domain",
        "allow": [
          "domain"
        ]
      },
      {
        "from": "application",
        "allow": [
          "application",
          "domain"
        ]
      },
      {
        "from": "features",
        "allow": [
          "features",
          "application",
          "domain"
        ]
      },
      {
        "from": "infrastructure",
        "allow": [
          "infrastructure",
          "application",
          "domain"
        ]
      },
      {
        "from": "presentation",
        "allow": [
          "presentation",
          "features",
          "application",
          "domain",
          "styles"
        ]
      },
      {
        "from": "bootstrap",
        "allow": [
          "features",
          "domain",
          "application",
          "infrastructure",
          "presentation",
          "bootstrap",
          "styles"
        ]
      },
      {
        "from": "test",
        "allow": [
          "features",
          "domain",
          "application",
          "infrastructure",
          "presentation",
          "bootstrap",
          "test",
          "harness",
          "tooling",
          "styles"
        ]
      },
      {
        "from": "harness",
        "allow": [
          "features",
          "domain",
          "application",
          "infrastructure",
          "presentation",
          "bootstrap",
          "test",
          "harness",
          "tooling",
          "styles"
        ]
      },
      {
        "from": "tooling",
        "allow": [
          "features",
          "domain",
          "application",
          "infrastructure",
          "presentation",
          "bootstrap",
          "test",
          "harness",
          "tooling",
          "styles"
        ]
      },
      {
        "from": "styles",
        "allow": [
          "styles"
        ]
      },
      {
        "from": "companion-concept",
        "allow": []
      }
    ]
  },
  "ignoreDependencies": [
    "obsidian"
  ],
  "ignoreUnresolvedImports": [
    "/__host.css",
    "./vendor/obsidian.css"
  ],
  "usedClassMembers": [
    {
      "extends": "PluginSettingTab",
      "members": [
        "getSettingDefinitions",
        "getControlValue",
        "setControlValue",
        "hide"
      ]
    }
  ],
  "rules": {
    "policy-violation": "off"
  }
}
