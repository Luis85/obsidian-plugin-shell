{
  "entry": [
    "src/main.ts",
    "harness/app/main.ts",
    "harness/style-fixture/fixture.js",
    "scripts/testing/node-reporter.mjs",
    "scripts/styles/export-host-css.mjs",
    "scripts/testing/check-browser-specimen.mjs",
    "scripts/harness/serve-style-fixture.mjs",
    "src/infrastructure/ui/static-plugin.ts",
    "src/styles/index.css",
    "harness/style-fixture/fixture.css",
    "harness/styles/obsidian.css",
    "harness/styles/simulated.css",
    "harness/styles/host-adapter.css",
    "scripts/makers/custom/registry.mjs",
    "src/bootstrap/authoring-domains.ts",
    "src/bootstrap/event-catalog.ts"
  ],
  "plugins": [
    "scripts/quality/fallow-node-tests.json"
  ],
  "ignorePatterns": [
    "dist-harness/**",
    "reports/**"
  ],
  "boundaries": {
    "coverage": {
      "requireAllFiles": true
    },
    "zones": [
      {
        "name": "domain",
        "patterns": [
          "src/domain/**"
        ]
      },
      {
        "name": "application",
        "patterns": [
          "src/application/**"
        ]
      },
      {
        "name": "features",
        "patterns": [
          "src/features/**"
        ]
      },
      {
        "name": "infrastructure",
        "patterns": [
          "src/infrastructure/**"
        ]
      },
      {
        "name": "presentation",
        "patterns": [
          "src/presentation/**"
        ]
      },
      {
        "name": "bootstrap",
        "patterns": [
          "src/bootstrap/**",
          "src/main.ts"
        ]
      },
      {
        "name": "test",
        "patterns": [
          "tests/**"
        ]
      },
      {
        "name": "harness",
        "patterns": [
          "harness/**"
        ]
      },
      {
        "name": "tooling",
        "patterns": [
          "scripts/**",
          "*.config.*"
        ]
      },
      {
        "name": "styles",
        "patterns": [
          "src/styles/**"
        ]
      }
    ],
    "rules": [
      {
        "from": "domain",
        "allow": [
          "domain"
        ]
      },
      {
        "from": "application",
        "allow": [
          "application",
          "domain"
        ]
      },
      {
        "from": "features",
        "allow": [
          "features",
          "application",
          "domain"
        ]
      },
      {
        "from": "infrastructure",
        "allow": [
          "infrastructure",
          "application",
          "domain"
        ]
      },
      {
        "from": "presentation",
        "allow": [
          "presentation",
          "features",
          "application",
          "domain",
          "styles"
        ]
      },
      {
        "from": "bootstrap",
        "allow": [
          "features",
          "domain",
          "application",
          "infrastructure",
          "presentation",
          "bootstrap",
          "styles"
        ]
      },
      {
        "from": "test",
        "allow": [
          "features",
          "domain",
          "application",
          "infrastructure",
          "presentation",
          "bootstrap",
          "test",
          "harness",
          "tooling",
          "styles"
        ]
      },
      {
        "from": "harness",
        "allow": [
          "features",
          "domain",
          "application",
          "infrastructure",
          "presentation",
          "bootstrap",
          "test",
          "harness",
          "tooling",
          "styles"
        ]
      },
      {
        "from": "tooling",
        "allow": [
          "features",
          "domain",
          "application",
          "infrastructure",
          "presentation",
          "bootstrap",
          "test",
          "harness",
          "tooling",
          "styles"
        ]
      },
      {
        "from": "styles",
        "allow": [
          "styles"
        ]
      }
    ]
  },
  "ignoreDependencies": [
    "obsidian"
  ],
  "ignoreUnresolvedImports": [
    "/__host.css",
    "./vendor/obsidian.css"
  ],
  "usedClassMembers": [
    {
      "extends": "PluginSettingTab",
      "members": [
        "getSettingDefinitions",
        "getControlValue",
        "setControlValue",
        "hide"
      ]
    }
  ],
  "rules": {
    "policy-violation": "off"
  }
}
