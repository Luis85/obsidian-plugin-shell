{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "#build/*": [
        "./node_modules/.nuxt-ui/*"
      ]
    },
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "harness/app/**/*.ts",
    "tests/runtime/**/*.ts",
    "tests/e2e/**/*.ts",
    "tests/obsidian/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
