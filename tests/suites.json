      "include": [
        "tests/concepts/*.browser.py"
      ],
      "exclude": [
        "tests/concepts/companion-prototypes.browser.py",
        "tests/concepts/companion-mvp.browser.py",
        "tests/concepts/companion.browser.py",
        "tests/concepts/companion-bricks.browser.py",
