      "inventory": {
        "source": "scripts/concepts/run-browser-checks.py",
        "pattern": "\\('([a-z-]+)', '[a-z-]+/[a-z-]+\\.json'\\)",
        "file": "tests/concepts/companion-$1.browser.py"
