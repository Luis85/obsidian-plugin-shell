    {
      "name": "companion:browser",
      "purpose": "Aggregated companion concept browser suites on one exact assembled artifact (Python Playwright suites plus the Node Playwright suites listed under companion:visual-browser, Chromium).",
      "runner": {
        "type": "command",
        "commands": [
          [
            "{python}",
            "scripts/concepts/run-browser-checks.py",
            "--real-storage"
          ]
        ]
