      "include": ["tests/tooling/gates.checks.mjs", "tests/tooling/coverage.checks.mjs", "tests/tooling/maintainability.checks.mjs", "tests/tooling/quality-thresholds.checks.mjs", "tests/tooling/lint-*.checks.mjs", "tests/tooling/repository.checks.mjs", "tests/tooling/projects-boundary.checks.mjs", "tests/tooling/site-templates-qualification.checks.mjs", "tests/tooling/docs-launchers.checks.mjs", "tests/tooling/test-quality.checks.mjs", "tests/tooling/style-literals*.checks.mjs", "tests/tooling/presentation.checks.mjs", "tests/tooling/evidence-*.checks.mjs", "tests/tooling/archive-*.checks.mjs", "tests/tooling/public-api-*.checks.mjs", "tests/tooling/dependency-*.checks.mjs", "tests/tooling/suite-*.checks.mjs", "tests/tooling/agent-*.checks.mjs", "tests/tooling/verify-*.checks.mjs"],
      "prerequisites": ["build"],
      "verify": "tooling",
      "npmScript": "test:quality",
      "workflows": [
        "ci"
      ]
    },
    {
      "name": "baseline",
      "purpose": "Dependency-free verification baseline: fault ledger, policy, runner, report, source, token and HTTP style-specimen checks, repeated three times.",
      "runner": {
        "type": "command",
        "commands": [
          [
            "{node}",
            "scripts/testing/verify-baseline.mjs",
            "--repeat",
            "3"
          ]
        ]
      },
      "include": [
        "tests/verification/*.test.mjs",
        "tests/harness-styles/*.test.mjs"
      ],
      "verify": "own-step",
      "verifyStep": "verify-baseline --repeat 3",
      "npmScript": "test:baseline",
      "workflows": [
        "ci"
      ]
    },
    {
      "name": "browser-specimen",
      "purpose": "Host-style specimen assertions in a real browser (served mode).",
      "runner": {
        "type": "command",
        "commands": [
          [
            "{node}",
            "scripts/testing/check-browser-specimen.mjs",
            "--mode",
            "served"
          ]
        ]
      },
      "include": [
        "tests/browser-specimen/*.checks.mjs"
      ],
      "prerequisites": [
        "chromium"
      ],
      "verify": "opt-in",
      "workflows": []
    },
    {
      "name": "e2e",
      "purpose": "Served harness in Chromium via Playwright: showcase, modals, persistence lifecycle, accessibility and design system.",
      "runner": {
        "type": "playwright"
      },
      "include": [
        "tests/e2e/*.spec.ts"
      ],
      "prerequisites": [
        "chromium",
        "harness-build"
      ],
      "verify": "opt-in",
      "npmScript": "test:e2e",
      "workflows": [
        "ci",
        "candidate-qualification"
      ]
    },
    {
      "name": "project",
      "purpose": "Generated product tests (tests/project) that exist only in a project created by the companion compiler.",
      "runner": {"type": "vitest", "config": "configs/testing/vitest.project.config.mjs"},
      "include": ["tests/project/**/*.test.ts", "tests/project/**/*.test.mjs"],
      "optional": true,
      "verify": "opt-in",
      "workflows": [
        "ci"
      ]
    },
    {
      "name": "project:ui-effects",
      "purpose": "Generated composition/UI-effect checks of a companion-generated project.",
      "runner": {
        "type": "node-test"
      },
      "include": [
        "tests/project/ui-effects/*.checks.mjs"
      ],
      "optional": true,
      "verify": "opt-in",
      "workflows": [
        "ci"
      ]
    },
    {
      "name": "obsidian",
      "purpose": "Vitest-driven end-to-end tests against a real sandboxed Obsidian host.",
      "runner": {
        "type": "npm-script",
        "script": "test:obsidian"
      },
      "include": [
        "tests/obsidian/**/*.obsidian.ts"
      ],
      "optional": true,
      "prerequisites": [
        "native-runner"
      ],
      "verify": "opt-in",
      "npmScript": "test:obsidian",
      "workflows": [
        "ci"
      ]
    }
  ],
  "aliases": {
    "tooling": "Every suite that verify runs in its serialized node --test tooling step."
  },
  "helpers": [
    {
      "purpose": "Synthetic vault copied for each real-Obsidian case",
      "include": [
        "tests/obsidian/vault/**"
      ]
    },
    {
      "purpose": "Concept browser-suite phases imported by a *.browser.mjs suite",
      "include": [
        "tests/concepts/*-phases.mjs"
      ]
    },
    {
      "purpose": "Tooling fixtures and shared helpers",
      "include": [
        "tests/tooling/*-fixture.mjs",
        "tests/tooling/file-symlink.mjs"
      ]
    },
    {
      "purpose": "Runtime fixtures, helpers and shared types",
      "include": [
        "tests/runtime/**/*-fixture.ts",
        "tests/runtime/**/*-helpers.ts",
        "tests/runtime/helpers.ts",
        "tests/runtime/memory-storage.ts",
        "tests/runtime/types.ts"
      ]
    },
    {
      "purpose": "Playwright fixtures and measurement helpers",
      "include": [
        "tests/e2e/*-fixture.ts",
        "tests/e2e/control-metrics.ts"
      ]
    },
    {
      "purpose": "Real-host test support, fixtures and declarations",
      "include": [
        "tests/obsidian/support/**",
        "tests/obsidian/fixtures/**",
        "tests/obsidian/**/*-fixture.*",
        "tests/obsidian/**/*-helpers.*",
        "tests/obsidian/**/*.d.ts"
      ]
    },
    {
      "purpose": "Generated project fixtures, ports and the Vitest UI setup file",
      "include": [
        "tests/project/fixtures/**",
        "tests/project/ui-bootstrap.mjs"
      ],
      "exclude": [
        "tests/project/**/*.test.ts",
        "tests/project/**/*.test.mjs"
      ]
    },
    {
      "purpose": "Workbench plugin source and configuration adjacent to plugin-local tests",
      "include": [
        "plugins/**"
      ],
      "exclude": [
        "plugins/*/tests/*.test.ts"
      ]
    }
  ]
}
