{
  "schemaVersion": 1,
  "description": "Every file under the scanned test roots belongs to exactly one suite or one helper entry. Run `npm run test:suites -- --check` after adding a test; docs/testing/TEST-SUITES.md explains each suite.",
  "documentation": "docs/testing/TEST-SUITES.md",
  "roots": [
    {
      "path": "tests/tooling"
    },
    {
      "path": "tests/runtime"
    },
    {
      "path": "tests/verification"
    },
    {
      "path": "tests/harness-styles"
    },
    {
      "path": "tests/browser-specimen"
    },
    {
      "path": "tests/concepts",
      "optional": true
    },
    {
      "path": "tests/e2e"
    },
    {
      "path": "tests/obsidian",
      "optional": true
    },
    {
      "path": "tests/project",
      "optional": true
    },
    {
      "path": "tests/hindsight",
      "optional": true
    },
    {
      "path": "plugins"
    }
  ],
  "helperRoots": [
    "tests/support",
    "tests/fixtures"
  ],
  "prerequisites": {
    "companion-current-build": {
      "file": "reports/companion-mvp/index.html",
      "hint": "Run npm run companion:build to build the current empty workspace."
    },
    "showcase-current-build": {
      "file": "reports/feature-showcase/clickdummy.html",
      "hint": "Generate the feature-showcase starter outside this checkout, install/build it, and copy its clickdummy.html here; see COMPANION-STARTERS.md."
    },
    "python3": {
      "probe": [
        "{python}",
        "--version"
      ],
      "hint": "Install Python 3.11+ or set PYTHON to an interpreter."
    },
    "python-jsonschema": {
      "probe": [
        "{python}",
        "-c",
        "import jsonschema"
      ],
      "hint": "Install jsonschema==4.26.0 in an isolated venv and set PYTHON. This is separate test tooling, not a runtime dependency."
    },
    "python-playwright": {
      "probe": [
        "{python}",
        "-c",
        "import playwright"
      ],
      "hint": "Create a scratch venv, pip install playwright==1.57.0, run `python -m playwright install chromium`, then set PYTHON to that venv interpreter (see companion-concept-verification.yml)."
    },
    "chromium": {
      "browser": true,
      "hint": "Provision Chromium explicitly: `node node_modules/@playwright/test/cli.js install chromium` (optionally with PLAYWRIGHT_BROWSERS_PATH in a scratch directory) or set SHELL_CHROMIUM. A mismatched installed revision is reported as browser-revision-mismatch with the exact SHELL_CHROMIUM value to opt in."
    },
    "harness-build": {
      "file": "dist-harness/harness/app/index.html",
      "hint": "Run `npm run harness:build` first."
    },
    "build": {
      "file": "dist/main.js",
      "hint": "Run `npm run build` first; the analyzer-archive gate copies the built dist/ assets."
    },
    "qualified-npm": {
      "env": "QUALIFIED_NPM",
      "hint": "Set QUALIFIED_NPM to the npm 11.19.1 CLI script (npm-cli.js); no global installation is used."
    },
    "native-runner": {
      "file": ".native-runner/node_modules/obsidian-launcher/package.json",
      "hint": "Provision the isolated native runner: npm install --prefix .native-runner --save-exact obsidian-launcher@3.2.1 (see TEST-SUITES.md)."
    },
    "concept-chromium": {
      "probe": [
        "{python}",
        "-c",
        "import os; assert os.path.isfile(os.environ.get('SHELL_CHROMIUM', '/usr/bin/chromium'))"
      ],
      "hint": "Set SHELL_CHROMIUM to the Chromium binary the Python Playwright install provides (default /usr/bin/chromium)."
    }
  },
  "suites": [
    {
      "name": "maker:pty",
      "purpose": "Real Linux/macOS pseudo-terminal authoring, agent parity, safe review and OS terminal restoration; standard-library Python only.",
      "runner": {
        "type": "command",
        "commands": [
          [
            "{python}",
            "-B",
            "tests/tooling/interactive-maker-pty.py",
            "--node",
            "{node}"
          ]
        ]
      },
      "include": [
        "tests/tooling/interactive-maker-pty.py"
      ],
      "prerequisites": [
        "python3"
      ],
      "verify": "opt-in",
      "npmScript": "test:maker:pty",
      "workflows": [
        "interactive-maker"
      ]
    },
    {
      "name": "maker",
      "purpose": "Interactive and agent-equivalent sketch/prototype makers, data-driven guides, guarded persistence and compiler-generated handoff packages.",
      "runner": {
        "type": "node-test"
      },
      "include": [
        "tests/tooling/interactive-maker-*.checks.mjs"
      ],
      "verify": "tooling",
      "npmScript": "test:maker",
      "workflows": [
        "interactive-maker"
      ]
    },
    {
      "name": "workbench-plugins",
      "purpose": "Trusted Workbench plugin SDK: plugin-local contracts, event bus, CLI/TUI contributions, framework adapters and custom starter contributions.",
      "runner": {
        "type": "node-test"
      },
      "include": [
        "plugins/*/tests/*.test.ts"
      ],
      "verify": "own-step",
      "verifyStep": "verify runs the Workbench plugin suite explicitly",
      "npmScript": "test:plugins",
      "workflows": [
        "ci",
        "interactive-maker"
      ]
    },
    {
      "name": "airship",
      "purpose": "Default-off project tooling, source preview mapping, safe explicit processes and regeneration preservation.",
      "runner": {
        "type": "node-test"
      },
      "include": [
        "tests/tooling/airship-*.checks.mjs"
      ],
      "verify": "tooling",
      "npmScript": "test:airship",
      "workflows": [
        "airship-compatibility"
      ]
    },
    {
      "name": "compiler",
      "purpose": "Dedicated compiler core, diagnostics, byte-compatibility, architecture, reporting and distribution contracts.",
      "runner": {
        "type": "node-test"
      },
      "include": [
        "tests/tooling/compiler-*.checks.mjs"
      ],
      "exclude": [
        "tests/tooling/compiler-properties.checks.mjs"
      ],
      "verify": "tooling",
      "npmScript": "test:compiler",
      "workflows": [
        "compiler-qualification"
      ]
    },
    {
