{
  "schemaVersion": 1,
  "description": "Every file under the scanned test roots belongs to exactly one suite or one helper entry. Run `npm run test:suites -- --check` after adding a test; docs/testing/TEST-SUITES.md explains each suite.",
  "documentation": "docs/testing/TEST-SUITES.md",
  "testLevels": [
    {
      "name": "unit",
      "summary": "One module's behavior in-process with in-memory or checked-in inputs and test doubles for its ports; no child process, temp directory, network, browser or host."
    },
    {
      "name": "component",
      "summary": "A composed part in-process with its real collaborators: a Vue view with its store, the plugin on the in-memory Obsidian host, a CLI/TUI command or editor session driven through its presentation layer."
    },
    {
      "name": "integration",
      "summary": "Real boundaries without a browser or host: child processes (the CLI, npm, git, Python), temp directories and repositories, generated projects on disk, loopback servers."
    },
    {
      "name": "e2e",
      "summary": "A real browser or a real Obsidian host. Opt-in in workflows and mandatory in the Release tier (scripts/quality/e2e-policy.mjs).",
      "paths": [
        "tests/e2e/**",
        "tests/obsidian/**",
        "tests/browser-specimen/**",
        "tests/concepts/*.browser.{py,mjs}"
      ]
    },
    {
      "name": "acceptance",
      "summary": "Acceptance-criteria checks of one increment, traced to its handoff.",
      "paths": [
        "tests/acceptance/**"
      ]
    }
  ],
  "pyramid": {
    "warnWhen": [
      {
        "upper": "e2e",
        "lower": "integration",
        "maxRatio": 1
      },
      {
        "upper": "integration",
        "lower": "unit",
        "maxRatio": 1
      }
    ]
  },
  "roots": [
    {
      "path": "tests/tooling"
    },
    {
      "path": "tests/acceptance",
      "optional": true
    },
    {
      "path": "tests/runtime"
    },
    {
      "path": "tests/verification"
    },
    {
      "path": "tests/harness-styles"
    },
    {
      "path": "tests/browser-specimen"
    },
    {
      "path": "tests/concepts",
      "optional": true
    },
    {
      "path": "tests/e2e"
    },
    {
      "path": "tests/obsidian",
      "optional": true
    },
    {
      "path": "tests/project",
      "optional": true
    },
    {
      "path": "tests/hindsight",
      "optional": true
    },
    {
      "path": "plugins"
    }
  ],
  "helperRoots": [
    "tests/support",
    "tests/fixtures"
  ],
  "prerequisites": {
    "companion-current-build": {
      "file": "reports/companion-mvp/index.html",
      "hint": "Run npm run companion:build to build the current empty workspace."
    },
    "showcase-current-build": {
      "file": "reports/feature-showcase/clickdummy.html",
      "hint": "Generate the feature-showcase starter outside this checkout, install/build it, and copy its clickdummy.html here; see COMPANION-STARTERS.md."
    },
    "python3": {
      "probe": [
        "{python}",
        "--version"
      ],
      "hint": "Install Python 3.11+ or set PYTHON to an interpreter."
    },
    "python-jsonschema": {
      "probe": [
        "{python}",
        "-c",
        "import jsonschema"
      ],
      "hint": "Install jsonschema==4.26.0 in an isolated venv and set PYTHON. This is separate test tooling, not a runtime dependency."
    },
    "python-playwright": {
      "probe": [
        "{python}",
        "-c",
        "import playwright"
      ],
      "hint": "Create a scratch venv, pip install playwright==1.57.0, run `python -m playwright install chromium`, then set PYTHON to that venv interpreter (see companion-concept-verification.yml)."
    },
    "chromium": {
      "browser": true,
      "hint": "Provision Chromium explicitly: `node node_modules/@playwright/test/cli.js install chromium` (optionally with PLAYWRIGHT_BROWSERS_PATH in a scratch directory) or set SHELL_CHROMIUM. A mismatched installed revision is reported as browser-revision-mismatch with the exact SHELL_CHROMIUM value to opt in."
    },
    "harness-build": {
      "file": "dist-harness/harness/app/index.html",
      "hint": "Run `npm run harness:build` first."
    },
    "build": {
      "file": "dist/main.js",
      "hint": "Run `npm run build` first; the analyzer-archive gate copies the built dist/ assets."
    },
    "qualified-npm": {
      "env": "QUALIFIED_NPM",
      "hint": "Set QUALIFIED_NPM to the npm 11.19.1 CLI script (npm-cli.js); no global installation is used."
    },
    "native-runner": {
      "file": ".native-runner/node_modules/obsidian-launcher/package.json",
      "hint": "Provision the isolated native runner: npm install --prefix .native-runner --save-exact obsidian-launcher@3.2.1 (see TEST-SUITES.md)."
    },
    "concept-chromium": {
      "probe": [
        "{python}",
        "-c",
        "import os; assert os.path.isfile(os.environ.get('SHELL_CHROMIUM', '/usr/bin/chromium'))"
      ],
      "hint": "Set SHELL_CHROMIUM to the Chromium binary the Python Playwright install provides (default /usr/bin/chromium)."
    }
  },
  "suites": [
