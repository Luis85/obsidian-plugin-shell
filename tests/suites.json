      "runner": {
        "type": "node-test"
      },
      "include": [
        "tests/tooling/prototype-*.checks.mjs",
        "tests/tooling/jev-concept-distribution.checks.mjs"
      ],
      "verify": "tooling",
      "npmScript": "test:prototypes",
      "workflows": [
        "ci"
      ]
    },
    {
      "name": "prototypes:python",
      "purpose": "Portable prototype package safety and static skill contract tests.",
      "runner": {
        "type": "command",
        "commands": [
          [
            "{python}",
            "-B",
            "-m",
            "unittest",
            "discover",
            "-s",
            ".claude/skills/companion-prototype-design/tests",
