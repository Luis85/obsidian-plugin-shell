      ]
    },
    {
      "name": "companion:mvp",
      "purpose": "Compiled Vue/Nuxt UI/Vue Flow sitemap, prototype versions/variants and complete v6 authoring round trips.",
      "runner": {
        "type": "command",
        "commands": [
          [
            "{node}",
