{
  "extends": "../configs/types/tsconfig.node.json",
  "compilerOptions": {
    "rootDir": ".",
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "../.cache/tsbuild/tests.tsbuildinfo"
  },
  "include": [
    "**/*.ts",
    "**/*.mts",
    "**/*.mjs"
  ],
  "exclude": [
    "fixtures/**"
  ],
  "references": [
    {
      "path": "../src/shared"
    },
    {
      "path": "../src/tui"
    },
    {
      "path": "../src/cli"
    },
    {
      "path": "../src/companion"
    },
    {
      "path": "../src/plugin"
    },
    {
      "path": "../configs/types/tsconfig.templates.json"
    },
    {
      "path": "../configs/types/tsconfig.test-kit.json"
    }
  ]
}
