{
  "schemaVersion": 1,
  "version": 1,
  "presets": [
    {
      "id": "plugin",
      "label": "Obsidian plugin",
      "targets": [
        "plugin"
      ],
      "frontends": [
        "nuxt-ui",
        "vanilla",
        "angular"
      ]
    },
    {
      "id": "webapp",
      "label": "Web application",
      "targets": [
        "webapp"
      ],
      "frontends": [
        "nuxt-ui",
        "vanilla"
      ]
    },
    {
      "id": "website",
      "label": "Website",
      "targets": [
        "website"
      ],
      "frontends": [
        "vanilla",
        "nuxt-ui"
      ]
    },
    {
      "id": "cli",
      "label": "Command-line application",
      "targets": [
        "cli"
      ],
      "frontends": [
        "none"
      ]
    },
    {
      "id": "hybrid",
      "label": "Hybrid — shared core, multiple runtimes",
      "targets": [],
      "frontends": [
        "nuxt-ui",
        "vanilla",
        "angular"
      ]
    }
  ],
  "frontends": [
    {
      "id": "nuxt-ui",
      "label": "Vue 3 + Nuxt UI",
      "framework": "vue",
      "ui": "nuxt-ui",
      "targets": [
        "plugin",
        "webapp",
        "website",
        "cli"
      ]
    },
    {
      "id": "vanilla",
      "label": "Vanilla — native Obsidian / browser DOM",
      "framework": "none",
      "ui": "native",
      "targets": [
        "plugin",
        "webapp",
        "website",
        "cli"
      ]
    },
    {
      "id": "angular",
      "label": "Angular — standalone components",
      "framework": "angular",
      "ui": "native",
      "targets": [
        "plugin",
        "webapp",
        "cli"
      ]
    },
    {
      "id": "none",
      "label": "No frontend — Node.js CLI",
      "framework": "none",
      "ui": "none",
      "targets": [
        "cli"
      ]
    }
  ],
  "runtimes": [
    {
      "id": "plugin",
      "label": "Obsidian plugin"
    },
    {
      "id": "webapp",
      "label": "Web application"
    },
    {
      "id": "website",
      "label": "Website"
    },
    {
      "id": "cli",
      "label": "Command-line application"
    }
  ]
}
