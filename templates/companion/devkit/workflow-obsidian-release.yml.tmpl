name: Obsidian release
# Validates a release with Obsidian's own community-directory checks (obsidianmd/obsidian-workflows, release mode:
# scanner lint, release assets, manifest version equal to the tag), attests main.js and styles.css and creates a
# DRAFT GitHub release. Push an X.Y.Z tag that matches manifest.json, then run this workflow on that tag ("Use
# workflow from" > Tags). The job only writes behind the `release` environment: add required reviewers to it under
# Settings > Environments. Review the draft on the Releases page and publish it yourself.
on:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: obsidian-release-${{ github.ref }}
  cancel-in-progress: false
jobs:
  release:
    # The action refuses a run that is not on a tag; skip it here so a branch run fails nothing.
    if: startsWith(github.ref, 'refs/tags/')
    runs-on: ubuntu-latest
    timeout-minutes: 30
    environment: release
    permissions:
      contents: write
      id-token: write
      attestations: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      # No dependency cache: a release builds from the lockfile alone.
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version-file: .nvmrc
      - name: Select the pinned npm
        run: |
          npm install --prefix "$RUNNER_TEMP/pinned-npm" --ignore-scripts --no-fund --package-lock=false npm@11.19.1
          echo "PINNED_NPM=$RUNNER_TEMP/pinned-npm/node_modules/npm/bin/npm-cli.js" >> "$GITHUB_ENV"
      - name: Install exact dependencies
        run: node "$PINNED_NPM" ci --no-fund
      - name: Release build
        run: node "$PINNED_NPM" run build
      # The action reads release assets from the project root and runs its own build command without a shell,
      # so the build runs above and its outputs are copied next to manifest.json.
      - name: Place the release assets at the project root
        run: cp dist/main.js dist/styles.css .
      - name: Validate, attest and create the draft release
        uses: obsidianmd/obsidian-workflows@8167caed39664214d82c86fdfa32e06d8d55f61d # v1.2.3
        with:
          type: plugin
          mode: release
          build: 'false'
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
