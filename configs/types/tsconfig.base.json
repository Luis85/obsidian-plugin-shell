{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "#build/*": [
        "../../node_modules/.nuxt-ui/*"
      ],
      "@test/obsidian": [
        "../../src/plugin/tests/support/obsidian/index.ts"
      ]
    },
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "exclude": ["../../src/cli/**"],
  "include": [
    "../../src/**/*.ts",
    "../../src/**/*.vue",
    "../../src/plugin/harness/app/**/*.ts",
    "../../src/plugin/tests/unit/**/*.ts",
    "../../tests/support/**/*.ts",
    "../../src/plugin/tests/e2e/**/*.ts",
    "../../src/plugin/tests/obsidian/**/*.ts",
    "../testing/playwright.config.ts"
  ]
}
