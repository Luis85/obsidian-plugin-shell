{
  "schemaVersion": 1,
  "id": "atom.button",
  "name": "Button",
  "version": "1.0.0",
  "templateType": "component",
  "atomicLevel": "atom",
  "category": "Actions",
  "description": "Primary or secondary action trigger.",
  "tags": [
    "atom",
    "actions",
    "button",
    "action"
  ],
  "recommendedFor": [
    "webapp",
    "obsidian-plugin"
  ],
  "useWhen": [
    "The application needs this common UI pattern."
  ],
  "avoidWhen": [
    "A simpler native control already communicates the interaction."
  ],
  "capabilities": [
    "action",
    "focus",
    "disabled-state"
  ],
  "states": [
    "default",
    "disabled"
  ],
  "props": [
    {
      "name": "label",
      "type": "string",
      "required": false,
      "default": "Action",
      "description": "Visible action label."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Disable interaction."
    }
  ],
  "events": [],
  "children": [],
  "slots": [],
  "design": {
    "kind": "catalog",
    "entryId": "u-button"
  },
  "accessibility": {
    "notes": "Use semantic labels, visible focus, sufficient contrast and a keyboard-reachable interaction model.",
    "keyboard": [
      "All interactive controls remain keyboard reachable."
    ],
    "aria": [
      "Prefer native semantics and explicit accessible names."
    ]
  }
}
