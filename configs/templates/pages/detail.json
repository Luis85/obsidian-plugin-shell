{
  "schemaVersion": 1,
  "id": "page.detail",
  "name": "Detail Page",
  "version": "1.0.0",
  "templateType": "page-with-bricks",
  "atomicLevel": "page",
  "category": "Pages",
  "description": "Focused entity details with actions and supporting context.",
  "tags": [
    "page",
    "pages",
    "detail"
  ],
  "recommendedFor": [
    "webapp",
    "obsidian-plugin"
  ],
  "useWhen": [
    "The application needs this common UI pattern."
  ],
  "avoidWhen": [
    "A simpler native control already communicates the interaction."
  ],
  "capabilities": [
    "record-detail"
  ],
  "states": [
    "default",
    "disabled"
  ],
  "props": [],
  "events": [],
  "children": [
    {
      "template": "organism.app-header",
      "slot": "header"
    },
    {
      "template": "organism.detail-panel",
      "slot": "main"
    },
    {
      "template": "molecule.action-group",
      "slot": "actions"
    }
  ],
  "slots": [
    {
      "id": "header",
      "role": "header",
      "accepts": [
        "organism"
      ]
    },
    {
      "id": "main",
      "role": "content",
      "accepts": [
        "organism"
      ]
    },
    {
      "id": "actions",
      "role": "content",
      "accepts": [
        "molecule"
      ]
    }
  ],
  "design": {
    "kind": "page",
    "layout": "stack"
  },
  "accessibility": {
    "notes": "Use semantic labels, visible focus, sufficient contrast and a keyboard-reachable interaction model.",
    "keyboard": [
      "All interactive controls remain keyboard reachable."
    ],
    "aria": [
      "Prefer native semantics and explicit accessible names."
    ]
  }
}
