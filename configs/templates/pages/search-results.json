{
  "schemaVersion": 1,
  "id": "page.search-results",
  "name": "Search Results",
  "version": "1.0.0",
  "templateType": "page-with-bricks",
  "atomicLevel": "page",
  "category": "Pages",
  "description": "Search, filters and result listing.",
  "tags": [
    "page",
    "pages",
    "search"
  ],
  "recommendedFor": [
    "webapp",
    "obsidian-plugin"
  ],
  "useWhen": [
    "The application needs this common UI pattern."
  ],
  "avoidWhen": [
    "A simpler native control already communicates the interaction."
  ],
  "capabilities": [
    "search-results"
  ],
  "states": [
    "default",
    "disabled"
  ],
  "props": [],
  "events": [],
  "children": [
    {
      "template": "organism.filter-bar",
      "slot": "search"
    },
    {
      "template": "organism.data-table",
      "slot": "results"
    }
  ],
  "slots": [
    {
      "id": "search",
      "role": "header",
