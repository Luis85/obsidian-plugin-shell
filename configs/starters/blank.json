  "processes": [
    {
      "id": "install",
      "label": "Install dependencies",
      "description": "Install the exact project dependency graph; network and dependency lifecycle effects require trust.",
      "dependsOn": [],
      "steps": [
        {
          "runner": "npm",
          "args": [
            "ci",
            "--no-fund"
          ],
          "cwd": ".",
          "timeout": 600000
        }
      ]
    },
    {
      "id": "verify",
      "label": "Verify generated project",
      "description": "Run the generated project verification without claiming native acceptance.",
      "dependsOn": [],
      "steps": [
        {
          "runner": "npm",
          "args": [
            "run",
            "verify:project"
          ],
          "cwd": ".",
          "timeout": 600000
        }
      ]
    },
    {
      "id": "build",
      "label": "Build project",
      "description": "Build generated project artifacts.",
      "dependsOn": [],
      "steps": [
        {
          "runner": "npm",
          "args": [
            "run",
            "build"
          ],
          "cwd": ".",
          "timeout": 600000
        }
      ]
    },
    {
      "id": "showcase",
      "label": "Preview project",
      "description": "Run the local browser showcase in the foreground; stop it with Ctrl+C.",
      "dependsOn": [],
      "steps": [
        {
          "runner": "npm",
          "args": [
            "run",
            "dev:ui"
          ],
          "cwd": ".",
          "timeout": 600000
        }
      ]
    }
  ],
  "firstRun": [
