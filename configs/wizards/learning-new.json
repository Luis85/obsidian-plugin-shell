{
  "$schema": "../schemas/wizard.schema.json",
  "schemaVersion": 1,
  "id": "learning-new",
  "version": 1,
  "title": "New learning",
  "description": "Capture one lesson learned as a Markdown note (type Learning) with the next free id in the configured paths.learnings folder, through one reviewed write.",
  "context": { "title": "Learnings", "details": ["Folder: {{folder}}", "Nothing is written until a reviewed plan is approved.", "Escape: previous step. Ctrl+C: cancel."] },
  "cancelMessage": "No learning was written.",
  "steps": [
    { "id": "load", "kind": "action", "action": "collection.load", "with": { "collection": "learning" } },
    { "id": "edit", "kind": "form", "title": "Learning", "form": "learning", "bind": "draft" },
    { "id": "review", "kind": "action", "action": "collection.plan-new", "retry": "edit" },
    { "id": "done", "kind": "end", "text": "Created {{created.id}} in {{created.path}}." }
  ]
}
