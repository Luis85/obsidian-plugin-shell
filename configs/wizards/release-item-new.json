{
  "$schema": "../schemas/wizard.schema.json",
  "schemaVersion": 1,
  "id": "release-item-new",
  "version": 1,
  "title": "New release item",
  "description": "Capture one release item as a Markdown note (type ReleaseItem) with the next free id in the configured paths.releaseItems folder, through one reviewed write.",
  "context": { "title": "Release items", "details": ["Folder: {{folder}}", "Nothing is written until a reviewed plan is approved.", "Escape: previous step. Ctrl+C: cancel."] },
  "cancelMessage": "No release item was written.",
  "steps": [
    { "id": "load", "kind": "action", "action": "collection.load", "with": { "collection": "release-item" } },
    { "id": "edit", "kind": "form", "title": "Release item", "form": "release-item", "bind": "draft" },
    { "id": "review", "kind": "action", "action": "collection.plan-new", "retry": "edit" },
    { "id": "done", "kind": "end", "text": "Created {{created.id}} in {{created.path}}." }
  ]
}
