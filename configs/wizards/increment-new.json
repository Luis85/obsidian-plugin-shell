{
  "$schema": "../schemas/wizard.schema.json",
  "schemaVersion": 1,
  "id": "increment-new",
  "version": 1,
  "title": "New increment",
  "description": "Capture one product increment as a Markdown note (type Increment) with the next free id in the configured paths.increments folder, through one reviewed write.",
  "context": { "title": "Increments", "details": ["Folder: {{folder}}", "Nothing is written until a reviewed plan is approved.", "Escape: previous step. Ctrl+C: cancel."] },
  "cancelMessage": "No increment was written.",
  "steps": [
    { "id": "load", "kind": "action", "action": "collection.load", "with": { "collection": "increment" } },
    { "id": "edit", "kind": "form", "title": "Increment", "form": "increment", "bind": "draft" },
    { "id": "review", "kind": "action", "action": "collection.plan-new", "retry": "edit" },
    { "id": "done", "kind": "end", "text": "Created {{created.id}} in {{created.path}}." }
  ]
}
