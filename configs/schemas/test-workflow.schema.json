{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "configs/schemas/test-workflow.schema.json",
  "title": "Workbench browser test workflow",
  "description": "Editor support only. src/cli/domain/test-workflow.ts is the authoritative validator; run node bin/app workflow check --json. See docs/development/TEST-WORKFLOWS.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "purpose", "status", "target", "steps"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "status": { "enum": ["draft", "active", "retired"] },
    "target": { "$ref": "#/$defs/target" },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 200, "maximum": 4000 },
        "height": { "type": "integer", "minimum": 200, "maximum": 4000 }
      }
    },
    "timeoutMs": { "$ref": "#/$defs/timeout" },
    "data": { "$ref": "#/$defs/data" },
    "steps": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/step" }, "description": "At most 30 screenshot steps with unique names." }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "timeout": { "type": "integer", "minimum": 100, "maximum": 60000 },
    "line": { "type": "string", "maxLength": 1000, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$" },
    "path": { "type": "string", "maxLength": 500, "pattern": "^/(?!/)[^\\s\\\\]*$" },
    "folder": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^/\\\\.][^\\\\]*$" },
    "target": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "folder"], "properties": { "kind": { "const": "static" }, "folder": { "$ref": "#/$defs/folder" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "package"], "properties": { "kind": { "const": "prototype" }, "package": { "$ref": "#/$defs/folder" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "url"], "properties": { "kind": { "const": "url" }, "url": { "type": "string", "pattern": "^http://(?:127\\.0\\.0\\.1|localhost|\\[::1\\]):[0-9]+(?:/[^?#\\s]*)?$" } } }
      ]
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "role": { "type": "string", "description": "An ARIA role such as button, link, textbox, heading, checkbox, combobox or form." },
        "name": { "$ref": "#/$defs/line", "description": "Accessible name; only with role." },
        "label": { "$ref": "#/$defs/line" },
        "placeholder": { "$ref": "#/$defs/line" },
        "text": { "$ref": "#/$defs/line" },
        "testId": { "$ref": "#/$defs/line" },
        "exact": { "type": "boolean" },
        "nth": { "type": "integer", "minimum": 0, "maximum": 99 },
        "within": { "$ref": "#/$defs/locator" }
      },
      "oneOf": [
        { "required": ["role"] }, { "required": ["label"] }, { "required": ["placeholder"] }, { "required": ["text"] }, { "required": ["testId"] }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["goto", "click", "fill", "select", "check", "uncheck", "press", "waitFor", "expectVisible", "expectHidden", "expectText", "expectUrl", "expectTitle", "expectCount", "expectValue", "screenshot"] },
        "id": { "$ref": "#/$defs/id" },
        "note": { "type": "string", "maxLength": 300 },
        "timeoutMs": { "$ref": "#/$defs/timeout" },
        "target": { "$ref": "#/$defs/locator" },
        "path": { "$ref": "#/$defs/path" },
        "value": { "$ref": "#/$defs/line" },
        "text": { "$ref": "#/$defs/line" },
        "key": { "type": "string", "pattern": "^(?:(?:Control|Shift|Alt|Meta)\\+){0,3}(?:[A-Za-z0-9]|Enter|Tab|Escape|Backspace|Delete|Space|Home|End|PageUp|PageDown|Arrow(?:Up|Down|Left|Right)|F(?:[1-9]|1[0-2]))$" },
        "count": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "state": { "enum": ["visible", "hidden", "attached", "detached"] },
        "match": { "enum": ["exact", "contains"] },
        "name": { "$ref": "#/$defs/id", "description": "screenshot: unique file name; the run writes <name>.png into its report folder." },
        "fullPage": { "type": "boolean", "description": "screenshot: capture the full scrollable page (not with target)." },
        "mask": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/locator" }, "description": "screenshot: elements painted over, such as dynamic data." },
        "caption": { "type": "string", "maxLength": 300, "description": "screenshot: shown in the documentation note and the run report." }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "values": { "type": "object", "description": "Inline values; keys are letters and digits; leaves are strings, numbers or booleans; at most four levels." },
        "fakeData": {
          "type": "object",
          "maxProperties": 10,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "config": { "$ref": "#/$defs/id" },
              "entity": { "$ref": "#/$defs/id" },
              "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
              "index": { "type": "integer", "minimum": 0, "maximum": 999 }
            },
            "oneOf": [{ "required": ["config"] }, { "required": ["entity"] }]
          }
        }
      }
    }
  }
}
