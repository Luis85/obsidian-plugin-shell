{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "configs/schemas/form.schema.json",
  "title": "Workbench data-driven form",
  "description": "Editor support only. src/cli/domain/form.ts is the authoritative validator (per-kind keys, references and limits); run node bin/app wizard check --json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "fields"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "commit": {
      "$ref": "#/$defs/hook"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/field"
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "kind": {
          "enum": [
            "text",
            "title",
            "number",
            "select",
            "multi",
            "boolean",
            "confirm",
            "list",
            "record",
            "section"
          ]
        },
        "label": {
          "type": "string",
          "description": "Prompt text; may contain {{path}} templates."
        },
        "help": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "description": "Replaces the generic validation message."
        },
        "bind": {
          "$ref": "#/$defs/path",
          "description": "Dotted path into the form value; defaults to id."
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "transient": {
          "type": "boolean"
        },
        "effect": {
          "$ref": "#/$defs/hook"
        },
        "default": {},
        "required": {
          "type": "boolean"
        },
        "maxLength": {
          "type": "number"
        },
        "multiline": {
          "type": "boolean"
        },
        "integer": {
          "type": "boolean"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "choicesFrom": {
          "$ref": "#/$defs/hook"
        },
        "yes": {
          "type": "string"
        },
        "no": {
          "type": "string"
        },
        "separator": {
          "type": "string"
        },
        "joiner": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        },
        "maxItems": {
          "type": "number"
        },
        "gate": {
          "type": "string"
        },
        "form": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "prepare": {
          "$ref": "#/$defs/hook"
        },
        "commit": {
          "$ref": "#/$defs/hook"
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "equals": {},
        "notEquals": {},
        "present": {
          "type": "boolean"
        },
        "changed": {
          "type": "boolean"
        }
      },
      "description": "Exactly one of equals, notEquals, present or changed; field names an earlier sibling, path reads the form value."
    },
    "choice": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string",
              "description": "May contain {{path}} templates."
            }
          }
        }
      ]
    },
    "hook": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
    },
    "path": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*)*$"
    }
  }
}
