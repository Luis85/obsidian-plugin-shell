{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "configs/schemas/wizard.schema.json",
  "title": "Workbench data-driven wizard",
  "description": "Editor support only. bin/domain/wizard.ts is the authoritative validator; run node bin/app wizard check --json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "steps"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cancelMessage": {
      "type": "string"
    },
    "reportErrors": {
      "type": "boolean"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "form",
            "guide",
            "action",
            "message",
            "end"
          ]
        },
        "title": {
          "type": "string",
          "description": "Location shown in the terminal header."
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "$ref": "form.schema.json#/$defs/path"
            },
            "equals": {},
            "notEquals": {},
            "present": {
              "type": "boolean"
            }
          }
        },
        "barrier": {
          "type": "boolean",
          "description": "Back cannot return past this step."
        },
        "retry": {
          "oneOf": [
            {
              "const": true
            },
            {
              "type": "string"
            }
          ]
        },
        "form": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "form.schema.json#/$defs/field"
          }
        },
        "bind": {
          "$ref": "form.schema.json#/$defs/path"
        },
        "initial": {
          "$ref": "form.schema.json#/$defs/path"
        },
        "guide": {
          "$ref": "form.schema.json#/$defs/path"
        },
        "agreement": {
          "type": "boolean"
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
        },
        "interactive": {
          "type": "boolean"
        },
        "with": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        }
      }
    }
  }
}
