{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "configs/schemas/learning-path.schema.json",
  "title": "Workbench learning path",
  "description": "Editor support only. bin/domain/learning-path.ts is the authoritative validator; run node bin/app learn check --json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "summary",
    "skill",
    "audience",
    "estimatedMinutes",
    "steps"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "prerequisites": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      }
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6000
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "goal"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "markdown": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 20000
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "pattern": "\\.md$"
                }
              }
            }
          ]
        },
        "docs": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string"
          }
        },
        "form": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "form.schema.json#/$defs/field"
          }
        },
        "bind": {
          "type": "string"
        },
        "checklist": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "winConditions": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "wizard",
            "form",
            "command"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "wizard": {
          "type": "string"
        },
        "form": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "bind": {
          "type": "string"
        },
        "command": {
          "type": "string",
          "pattern": "^(?:node bin/app|npm run) "
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "checklist-complete",
            "form-valid",
            "answer",
            "file-exists",
            "file-contains",
            "wizard-completed",
            "wizard-check"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "equals": {
          "type": [
            "string",
            "number",
            "boolean",
            "array"
          ]
        },
        "notEquals": {
          "type": [
            "string",
            "number",
            "boolean",
            "array"
          ]
        },
        "present": {
          "type": "boolean"
        },
        "file": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "wizard": {
          "type": "string"
        }
      }
    }
  }
}
