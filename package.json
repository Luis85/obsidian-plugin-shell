{
  "name": "plugin-shell",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "./src/shared/*",
    "#tui/*": "./src/tui/*"
  },
  "bin": {
    "obs-shell": "bin/app"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@iconify-json/lucide": "1.2.139",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/test-utils": "2.5.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "eslint-plugin-vue": "10.11.1",
    "fallow": "3.31.0",
    "fast-check": "4.10.2",
    "happy-dom": "20.14.5",
    "obsidian": "1.13.1",
    "oxlint": "1.86.0",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@nuxt/ui": "4.11.3",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-i18n": "11.4.13",
    "yaml": "2.9.1"
  },
  "description": "An Obsidian plugin foundation with a working Nuxt UI capability showcase",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.19.1 <13"
  },
  "scripts": {
    "memory": "node --experimental-strip-types src/cli/tooling/hindsight/cli.ts",
    "test:memory": "node --experimental-strip-types --test tooling/tests/hindsight/*.checks.mjs",
    "test:memory:python": "python -m unittest discover -s tooling/tests/hindsight -p test_*.py -v",
    "typecheck:memory": "node node_modules/typescript/bin/tsc --noEmit --project configs/types/tsconfig.hindsight.json",
    "setup": "node tooling/setup.mjs",
    "make": "node bin/app make",
    "entities:check": "node tooling/makers/entities.mjs --check",
    "entities:catalog": "node tooling/makers/entities.mjs",
    "dev:ui": "vite --config configs/bundling/vite.harness.config.mjs --host 127.0.0.1 --open /harness/app/",
    "dev": "node tooling/dev/watch-local.mjs --no-local",
    "build": "node tooling/bundling/build.mjs",
    "build:local": "node tooling/dev/install-local.mjs",
    "test-build": "npm run build:local",
    "typecheck": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit && node node_modules/typescript/bin/tsc --noEmit --project configs/types/tsconfig.maker.json",
    "test": "vitest run --config configs/testing/vitest.config.mjs",
    "test:watch": "vitest --config configs/testing/vitest.config.mjs",
    "test:coverage": "vitest run --coverage --config configs/testing/vitest.config.mjs",
    "harness:build": "vite build --config configs/bundling/vite.harness.config.mjs",
    "harness:preview": "vite preview --config configs/bundling/vite.harness.config.mjs --host 127.0.0.1 --port 4180 --strictPort",
    "test:e2e": "playwright test --config configs/testing/playwright.config.ts",
    "ui:gallery": "node tooling/ui/review-gallery.mjs",
    "test:baseline": "node tooling/testing/verify-baseline.mjs --repeat 3",
    "check:tokens": "node tooling/styles/check-tokens.mjs",
    "check:style-literals": "node tooling/styles/check-style-literals.mjs",
    "check:source": "node tooling/quality/check-source.mjs",
    "check:presentation": "node tooling/quality/check-presentation.mjs",
    "check:self-review": "node tooling/quality/self-review.mjs",
    "check:artifacts": "node tooling/quality/check-artifacts.mjs",
    "lint": "node tooling/quality/lint-source.mjs && eslint -c configs/lint/eslint.config.mjs src templates/companion/runtime",
    "analyze": "fallow dead-code -c configs/quality/fallow.json",
    "verify": "node tooling/quality/verify.mjs",
    "help": "node tooling/help.mjs",
    "dev:local": "node tooling/dev/watch-local.mjs",
    "check:architecture": "node tooling/quality/check-architecture.mjs",
    "test:native": "node tooling/testing/check-native.mjs",
    "test:obsidian": "node tooling/testing/run-obsidian-tests.mjs",
    "dev:obsidian": "node tooling/dev/obsidian-dev.mjs",
    "test:setup-policy": "node --test src/shared/tests/npm-install.checks.mjs",
    "check:analyzer": "node tooling/quality/check-analyzer.mjs",
    "check:maintainability": "node tooling/quality/check-maintainability.mjs",
    "evidence": "node tooling/testing/evidence-cli.mjs",
    "measure:assets": "node tooling/testing/asset-sizes.mjs",
    "check:security": "node tooling/security/audit.mjs",
    "check:dependencies": "node tooling/security/check-dependencies.mjs",
    "test:coverage:production": "vitest run --coverage --config configs/testing/vitest.production.config.mjs && node tooling/quality/coverage-inventory.mjs",
    "examples:remove": "node tooling/examples/cli.mjs",
    "maintenance:status": "node tooling/maintenance/status.mjs",
    "release:prepare": "node src/cli/tooling/release/prepare.mjs",
    "release:rehearse": "node tooling/release/rehearse.mjs",
    "check:test-quality": "node tooling/quality/check-test-quality.mjs",
    "check:repository": "node tooling/quality/check-repository.mjs",
    "check:projects": "node tooling/projects/projects.mjs check",
    "projects:sync": "node tooling/projects/projects.mjs sync",
    "check:docs-launchers": "node tooling/quality/check-docs-launchers.mjs",
    "test:mutation": "node tooling/quality/mutation-smoke.mjs",
    "release:plan": "node src/cli/tooling/release/promotion-plan.mjs",
    "events:catalog": "node tooling/events/catalog.mjs",
    "events:check": "node tooling/events/catalog.mjs --check",
    "release:operate": "node tooling/release/cli.mjs",
    "release:changelog": "node src/cli/tooling/release/changelog.mjs",
    "release:cut": "node tooling/release/cut.mjs",
    "release:publish": "node tooling/release/publish.mjs",
    "increment:new": "node tooling/delivery/increment.mjs new",
    "dor": "node tooling/delivery/ready.mjs",
    "dod": "node tooling/delivery/done.mjs",
    "acceptance:stubs": "node tooling/delivery/acceptance.mjs stubs",
    "companion:generate": "node tooling/companion-tools/generate.mjs",
    "companion:scaffold": "node bin/app generate",
    "test:generator": "node tooling/testing/suites.mjs generator",
    "test:visual": "node tooling/testing/suites.mjs visual",
    "typecheck:generator": "node node_modules/typescript/bin/tsc --noEmit --project configs/types/tsconfig.generator.json",
    "app": "node bin/app",
    "new": "node bin/app new",
    "capabilities": "node tooling/operations/cli.mjs",
    "framework:setup": "node bin/app setup",
    "framework:pack": "node bin/app framework pack",
    "typecheck:framework": "node node_modules/typescript/bin/tsc --noEmit --project configs/types/tsconfig.framework.json",
    "test:framework-cli": "node tooling/testing/suites.mjs cli",
    "test:suites": "node tooling/testing/suites.mjs",
    "test:unit": "node tooling/testing/suites.mjs --level unit",
    "test:integration": "node tooling/testing/suites.mjs --level integration",
    "test:runtime": "node tooling/testing/suites.mjs runtime",
    "test:tooling": "node tooling/testing/suites.mjs tooling",
    "test:cli": "node tooling/testing/suites.mjs cli",
    "test:cli:journey": "node tooling/testing/suites.mjs cli:journey",
    "test:companion": "node tooling/testing/suites.mjs companion companion:assembly",
    "test:companion:browser": "node tooling/testing/suites.mjs companion:browser",
    "test:test-data": "node tooling/testing/suites.mjs test-data",
    "test:makers": "node tooling/testing/suites.mjs makers",
    "test:native-tooling": "node tooling/testing/suites.mjs native",
    "test:setup": "node tooling/testing/suites.mjs setup",
    "test:release": "node tooling/testing/suites.mjs release",
    "test:quality": "node tooling/testing/suites.mjs quality",
    "check": "node tooling/bundling/build-cli.mjs && node src/cli/app.ts check",
    "check:fast": "node bin/app check --fast",
    "check:submission": "node bin/app check submission",
    "companion:build": "node tooling/concepts/build-mvp.mjs",
    "typecheck:authoring": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit --project configs/types/tsconfig.authoring.json",
    "prototype:build": "node .claude/skills/companion-prototype-design/scripts/prototype.mjs build",
    "test:prototypes": "node tooling/testing/suites.mjs prototypes",
    "test:prototypes:python": "node tooling/testing/suites.mjs prototypes:python",
    "prototype:tools": "node .claude/skills/companion-prototype-design/scripts/prototype.mjs",
    "test:compiler": "node tooling/testing/suites.mjs compiler",
    "typecheck:compiler": "node node_modules/typescript/bin/tsc --noEmit --project configs/types/tsconfig.compiler.json",
    "typecheck:sitemap": "node node_modules/typescript/bin/tsc --noEmit --project configs/types/tsconfig.sitemap.json",
    "check:compiler-architecture": "node tooling/compiler/check-architecture.mjs",
    "test:compiler:properties": "node tooling/testing/suites.mjs compiler:properties",
    "qualify:compiler": "node tooling/compiler/qualify.mjs",
    "test:compiler:coverage": "node tooling/compiler/coverage.mjs",
    "debug:compiler": "node --inspect-brk --experimental-strip-types tooling/compiler/debug-fixture.mjs",
    "test:compiler:browser": "node tooling/compiler/verify-browser.mjs",
    "test:airship": "node tooling/testing/suites.mjs airship",
    "maker": "node bin/app studio",
    "prototype:make": "node bin/app prototype",
    "typecheck:maker": "node node_modules/typescript/bin/tsc --noEmit --project configs/types/tsconfig.maker.json",
    "test:maker": "node tooling/testing/suites.mjs maker",
    "test:maker:pty": "node tooling/testing/suites.mjs maker:pty",
    "test:coverage:maker": "vitest run --coverage --config configs/testing/vitest.maker.config.mjs && node tooling/quality/maker-coverage.mjs",
    "test:plugins": "node tooling/testing/suites.mjs workbench-plugins",
    "check:plugins": "node tooling/quality/check-workbench-plugins.mjs",
    "build:cli": "node tooling/bundling/build-cli.mjs",
    "app:dev": "node src/cli/app.ts"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "vue-demi@0.14.10": true,
    "fsevents": false
  },
  "overrides": {
    "fontless@0.2.1": {
      "esbuild": "0.28.2"
    }
  },
  "packageManager": "npm@11.19.1"
}
