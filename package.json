{
  "name": "plugin-shell",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "bin": {
    "obs-shell": "bin/app"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@iconify-json/lucide": "1.2.137",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.2",
    "@vue/test-utils": "2.5.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "eslint-plugin-vue": "10.11.1",
    "fallow": "3.30.0",
    "fast-check": "4.10.2",
    "happy-dom": "20.14.5",
    "obsidian": "1.13.1",
    "oxlint": "1.86.0",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.2",
    "vue-tsc": "3.3.11"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@nuxt/ui": "4.11.2",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-i18n": "11.4.12",
    "yaml": "2.9.1"
  },
  "description": "An Obsidian plugin foundation with a working Nuxt UI capability showcase",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.19.1 <13"
  },
  "scripts": {
    "memory": "node --experimental-strip-types scripts/hindsight/cli.ts",
    "test:memory": "node --experimental-strip-types --test tests/hindsight/*.checks.mjs",
    "test:memory:python": "python -m unittest discover -s tests/hindsight -p test_*.py -v",
    "typecheck:memory": "node node_modules/typescript/bin/tsc --noEmit --project configs/types/tsconfig.hindsight.json",
    "setup": "node scripts/setup.mjs",
    "make": "node bin/app make",
    "entities:check": "node scripts/makers/entities.mjs --check",
    "entities:catalog": "node scripts/makers/entities.mjs",
    "dev:ui": "vite --config configs/bundling/vite.harness.config.mjs --host 127.0.0.1 --open /harness/app/",
    "dev": "node scripts/dev/watch-local.mjs --no-local",
    "build": "node scripts/bundling/build.mjs",
    "build:local": "node scripts/dev/install-local.mjs",
    "test-build": "npm run build:local",
    "typecheck": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit",
    "test": "vitest run --config configs/testing/vitest.config.mjs",
    "test:watch": "vitest --config configs/testing/vitest.config.mjs",
    "test:coverage": "vitest run --coverage --config configs/testing/vitest.config.mjs",
    "harness:build": "vite build --config configs/bundling/vite.harness.config.mjs",
    "harness:preview": "vite preview --config configs/bundling/vite.harness.config.mjs --host 127.0.0.1 --port 4180 --strictPort",
    "test:e2e": "playwright test --config configs/testing/playwright.config.ts",
    "ui:gallery": "node scripts/ui/review-gallery.mjs",
    "test:baseline": "node scripts/testing/verify-baseline.mjs --repeat 3",
    "check:tokens": "node scripts/styles/check-tokens.mjs",
    "check:style-literals": "node scripts/styles/check-style-literals.mjs",
    "check:source": "node scripts/quality/check-source.mjs",
    "check:presentation": "node scripts/quality/check-presentation.mjs",
    "check:self-review": "node scripts/quality/self-review.mjs",
    "check:artifacts": "node scripts/quality/check-artifacts.mjs",
    "lint": "node scripts/quality/lint-source.mjs && eslint -c configs/lint/eslint.config.mjs src bin plugins templates/companion/runtime",
    "analyze": "fallow dead-code -c configs/quality/fallow.json",
    "verify": "node scripts/quality/verify.mjs",
    "help": "node scripts/help.mjs",
    "dev:local": "node scripts/dev/watch-local.mjs",
    "check:architecture": "node scripts/quality/check-architecture.mjs",
    "test:native": "node scripts/testing/check-native.mjs",
    "test:obsidian": "node scripts/testing/run-obsidian-tests.mjs",
    "dev:obsidian": "node scripts/dev/obsidian-dev.mjs",
    "test:setup-policy": "node --test tests/tooling/npm-install.checks.mjs",
    "check:analyzer": "node scripts/quality/check-analyzer.mjs",
    "check:maintainability": "node scripts/quality/check-maintainability.mjs",
    "evidence": "node scripts/testing/evidence-cli.mjs",
    "measure:assets": "node scripts/testing/asset-sizes.mjs",
    "check:security": "node scripts/security/audit.mjs",
    "check:dependencies": "node scripts/security/check-dependencies.mjs",
    "test:coverage:production": "vitest run --coverage --config configs/testing/vitest.production.config.mjs && node scripts/quality/coverage-inventory.mjs",
    "examples:remove": "node scripts/examples/cli.mjs",
    "maintenance:status": "node scripts/maintenance/status.mjs",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:rehearse": "node scripts/release/rehearse.mjs",
    "check:test-quality": "node scripts/quality/check-test-quality.mjs",
    "check:repository": "node scripts/quality/check-repository.mjs",
    "check:projects": "node scripts/projects/projects.mjs check",
    "projects:sync": "node scripts/projects/projects.mjs sync",
    "check:docs-launchers": "node scripts/quality/check-docs-launchers.mjs",
    "test:mutation": "node scripts/quality/mutation-smoke.mjs",
    "release:plan": "node scripts/release/promotion-plan.mjs",
    "events:catalog": "node scripts/events/catalog.mjs",
    "events:check": "node scripts/events/catalog.mjs --check",
    "release:operate": "node scripts/release/cli.mjs",
    "release:changelog": "node scripts/release/changelog.mjs",
    "release:cut": "node scripts/release/cut.mjs",
    "release:publish": "node scripts/release/publish.mjs",
    "increment:new": "node scripts/delivery/increment.mjs new",
    "dor": "node scripts/delivery/ready.mjs",
    "dod": "node scripts/delivery/done.mjs",
    "acceptance:stubs": "node scripts/delivery/acceptance.mjs stubs",
    "companion:generate": "node scripts/companion-tools/generate.mjs",
    "companion:scaffold": "node bin/app generate",
    "test:generator": "node scripts/testing/suites.mjs generator",
    "test:visual": "node scripts/testing/suites.mjs visual",
    "typecheck:generator": "node node_modules/typescript/bin/tsc --noEmit --project configs/types/tsconfig.generator.json",
    "app": "node bin/app",
    "new": "node bin/app new",
    "capabilities": "node scripts/operations/cli.mjs",
    "framework:setup": "node bin/app setup",
    "framework:pack": "node bin/app framework pack",
    "typecheck:framework": "node node_modules/typescript/bin/tsc --noEmit --project configs/types/tsconfig.framework.json",
    "test:framework-cli": "node scripts/testing/suites.mjs cli",
    "test:suites": "node scripts/testing/suites.mjs",
    "test:unit": "node scripts/testing/suites.mjs --level unit",
    "test:integration": "node scripts/testing/suites.mjs --level integration",
    "test:runtime": "node scripts/testing/suites.mjs runtime",
    "test:tooling": "node scripts/testing/suites.mjs tooling",
    "test:cli": "node scripts/testing/suites.mjs cli",
    "test:cli:journey": "node scripts/testing/suites.mjs cli:journey",
    "test:companion": "node scripts/testing/suites.mjs companion companion:assembly",
    "test:companion:browser": "node scripts/testing/suites.mjs companion:browser",
    "test:test-data": "node scripts/testing/suites.mjs test-data",
    "test:makers": "node scripts/testing/suites.mjs makers",
    "test:native-tooling": "node scripts/testing/suites.mjs native",
    "test:setup": "node scripts/testing/suites.mjs setup",
    "test:release": "node scripts/testing/suites.mjs release",
    "test:quality": "node scripts/testing/suites.mjs quality",
    "check": "node bin/app check",
    "check:fast": "node bin/app check --fast",
    "check:submission": "node bin/app check submission",
    "companion:build": "node scripts/concepts/build-mvp.mjs",
    "typecheck:authoring": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit --project configs/types/tsconfig.authoring.json",
    "prototype:build": "node .claude/skills/companion-prototype-design/scripts/prototype.mjs build",
    "test:prototypes": "node scripts/testing/suites.mjs prototypes",
    "test:prototypes:python": "node scripts/testing/suites.mjs prototypes:python",
    "prototype:tools": "node .claude/skills/companion-prototype-design/scripts/prototype.mjs",
    "test:compiler": "node scripts/testing/suites.mjs compiler",
    "typecheck:compiler": "node node_modules/typescript/bin/tsc --noEmit --project configs/types/tsconfig.compiler.json",
    "typecheck:sitemap": "node node_modules/typescript/bin/tsc --noEmit --project configs/types/tsconfig.sitemap.json",
    "check:compiler-architecture": "node scripts/compiler/check-architecture.mjs",
    "test:compiler:properties": "node scripts/testing/suites.mjs compiler:properties",
    "qualify:compiler": "node scripts/compiler/qualify.mjs",
    "test:compiler:coverage": "node scripts/compiler/coverage.mjs",
    "debug:compiler": "node --inspect-brk --experimental-strip-types scripts/compiler/debug-fixture.mjs",
    "test:compiler:browser": "node scripts/compiler/verify-browser.mjs",
    "test:airship": "node scripts/testing/suites.mjs airship",
    "maker": "node bin/app studio",
    "prototype:make": "node bin/app prototype",
    "typecheck:maker": "node node_modules/typescript/bin/tsc --noEmit --project configs/types/tsconfig.maker.json",
    "test:maker": "node scripts/testing/suites.mjs maker",
    "test:maker:pty": "node scripts/testing/suites.mjs maker:pty",
    "test:coverage:maker": "vitest run --coverage --config configs/testing/vitest.maker.config.mjs && node scripts/quality/maker-coverage.mjs",
    "test:plugins": "node scripts/testing/suites.mjs workbench-plugins",
    "check:plugins": "node scripts/quality/check-workbench-plugins.mjs"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "vue-demi@0.14.10": true,
    "fsevents": false
  },
  "overrides": {
    "fontless@0.2.1": {
      "esbuild": "0.28.2"
    }
  },
  "packageManager": "npm@11.19.1"
}
