{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/capacity-planner/plan.schema.json",
  "title": "Capacity Planner whole-plan engine document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "engine", "exportedAt", "project", "plan", "baselines"],
  "properties": {
    "schema": {"const": "capacity-planner.plan"},
    "version": {"const": 1},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "capacity-planner"},
        "version": {"const": 1}
      }
    },
    "exportedAt": {"type": "string", "format": "date-time"},
    "project": {"$ref": "#/$defs/project"},
    "plan": {"$ref": "#/$defs/plan"},
    "baselines": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "entityId": {"type": "string", "minLength": 1},
    "iteration": {
      "type": "object",
      "required": ["id", "index", "name", "start", "end"],
      "properties": {
        "id": {"$ref": "#/$defs/entityId"}, "index": {"type": "number"}, "name": {"type": "string"},
        "start": {"type": "string"}, "end": {"type": "string"}
      }
    },
    "role": {
      "type": "object",
      "required": ["id", "name", "dayRate", "manualFte"],
      "properties": {
        "id": {"$ref": "#/$defs/entityId"}, "name": {"type": "string", "minLength": 1},
        "dayRate": {"type": "number", "minimum": 0}, "manualFte": {"type": "number", "minimum": 0},
        "budgetCap": {"type": "number", "minimum": 0}, "inactive": {"type": "boolean"}
      }
    },
    "person": {
      "type": "object",
      "required": ["id", "name", "roleId", "baseFte"],
      "properties": {
        "id": {"$ref": "#/$defs/entityId"}, "name": {"type": "string", "minLength": 1}, "roleId": {"$ref": "#/$defs/entityId"},
        "baseFte": {"type": "number", "minimum": 0}, "inactive": {"type": "boolean"},
        "availabilityByIteration": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
        "leave": {"type": "array", "items": {"type": "object"}}
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "title", "units"],
      "properties": {
        "id": {"$ref": "#/$defs/entityId"}, "title": {"type": "string", "minLength": 1}, "units": {"type": "number", "minimum": 0},
        "ownerPersonId": {"type": ["string", "null"]}, "assigneeIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "inactive": {"type": "boolean"}
      }
    },
    "actual": {
      "type": "object",
      "required": ["id", "taskId", "roleId", "iterationId", "hours", "dayRate"],
      "properties": {
        "id": {"$ref": "#/$defs/entityId"}, "taskId": {"$ref": "#/$defs/entityId"}, "roleId": {"$ref": "#/$defs/entityId"},
        "personId": {"type": ["string", "null"]}, "iterationId": {"$ref": "#/$defs/entityId"},
        "hours": {"type": "number", "exclusiveMinimum": 0}, "dayRate": {"type": "number", "minimum": 0},
        "note": {"type": "string"}, "at": {"type": "string"}
      }
    },
    "project": {
      "type": "object",
      "required": ["id", "name", "hoursPerDay", "workingDays", "unitName", "hoursPerUnit", "timelineOwner", "timeline", "iterations", "holidays", "roles", "people", "tasks", "actuals", "persistence"],
      "properties": {
        "id": {"$ref": "#/$defs/entityId"}, "name": {"type": "string", "minLength": 1}, "orderValue": {"type": "number", "minimum": 0},
        "hoursPerDay": {"type": "number", "exclusiveMinimum": 0}, "workingDays": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 6}},
        "unitName": {"type": "string", "minLength": 1}, "hoursPerUnit": {"type": "number", "minimum": 0}, "timelineOwner": {"type": "string"},
        "timeline": {"type": "object"}, "iterations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/iteration"}},
        "holidays": {"type": "array", "items": {"type": "object"}}, "roles": {"type": "array", "items": {"$ref": "#/$defs/role"}},
        "people": {"type": "array", "items": {"$ref": "#/$defs/person"}}, "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}},
        "actuals": {"type": "array", "items": {"$ref": "#/$defs/actual"}}, "persistence": {"type": "object"}
      }
    },
    "allocation": {
      "type": "object",
      "required": ["id", "taskId", "roleId", "iterationId", "hours"],
      "properties": {
        "id": {"$ref": "#/$defs/entityId"}, "taskId": {"$ref": "#/$defs/entityId"}, "roleId": {"$ref": "#/$defs/entityId"},
        "personId": {"type": ["string", "null"]}, "iterationId": {"$ref": "#/$defs/entityId"}, "hours": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "plan": {
      "type": "object",
      "required": ["id", "name", "status", "budget", "contingencyPct", "targetMarginPct", "rolePlans", "allocations", "nonLaborCosts"],
      "properties": {
        "id": {"$ref": "#/$defs/entityId"}, "name": {"type": "string", "minLength": 1}, "status": {"enum": ["draft", "approved", "archived"]},
        "budget": {"type": "number", "minimum": 0}, "contingencyPct": {"type": "number", "minimum": 0, "maximum": 100},
        "targetMarginPct": {"type": "number", "minimum": -100, "maximum": 100}, "createdAt": {"type": "string"},
        "rolePlans": {"type": "object"}, "allocations": {"type": "array", "items": {"$ref": "#/$defs/allocation"}},
        "nonLaborCosts": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
