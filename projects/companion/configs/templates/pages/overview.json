{
  "schemaVersion": 1,
  "id": "page.overview",
  "name": "Overview Page",
  "version": "1.0.0",
  "templateType": "page-with-bricks",
  "atomicLevel": "page",
  "category": "Pages",
  "description": "General product overview with header, KPI summary and recent activity.",
  "tags": [
    "page",
    "pages",
    "overview",
    "dashboard"
  ],
  "recommendedFor": [
    "webapp",
    "obsidian-plugin"
  ],
  "useWhen": [
    "The application needs this common UI pattern."
  ],
  "avoidWhen": [
    "A simpler native control already communicates the interaction."
  ],
  "capabilities": [
    "overview"
  ],
  "states": [
    "default",
    "disabled"
  ],
  "props": [],
  "events": [],
  "children": [
    {
      "template": "organism.app-header",
      "slot": "header"
    },
    {
      "template": "organism.kpi-grid",
      "slot": "summary"
    },
    {
      "template": "organism.activity-feed",
      "slot": "activity"
    }
  ],
  "slots": [
    {
      "id": "header",
      "role": "header",
      "accepts": [
        "organism"
      ]
    },
    {
      "id": "summary",
      "role": "content",
      "accepts": [
        "organism"
      ]
    },
    {
      "id": "activity",
      "role": "content",
      "accepts": [
        "organism"
      ]
    }
  ],
  "design": {
    "kind": "page",
    "layout": "stack"
  },
  "accessibility": {
    "notes": "Use semantic labels, visible focus, sufficient contrast and a keyboard-reachable interaction model.",
    "keyboard": [
      "All interactive controls remain keyboard reachable."
    ],
    "aria": [
      "Prefer native semantics and explicit accessible names."
    ]
  }
}
