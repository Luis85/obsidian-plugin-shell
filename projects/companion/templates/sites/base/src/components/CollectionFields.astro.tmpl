---
import { collectionInfo } from '../lib/collections';

/** The field reference of one collection: property id, display name and inferred type, in view column order. */
interface Props { name: string }
const { name } = Astro.props;
const info = collectionInfo(name);
const captionId = `fields-${name}`;
---
{info && (
  <div class="table-scroll" role="region" aria-labelledby={captionId} tabindex="0">
    <table class="collection-table">
      <caption id={captionId}>Fields of {name}</caption>
      <thead>
        <tr><th scope="col">Display name</th><th scope="col">Property</th><th scope="col">Type</th></tr>
      </thead>
      <tbody>
        {info.fields.map(field => (
          <tr><th scope="row">{field.displayName}</th><td><code>{field.property}</code></td><td>{field.type}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
)}
