{
  "name": "workbench-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "obs-shell": "bin/app"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@iconify-json/lucide": "1.2.139",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.2",
    "@vue/test-utils": "2.5.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "eslint-plugin-vue": "10.11.1",
    "fallow": "3.31.0",
    "fast-check": "4.10.2",
    "happy-dom": "20.14.5",
    "obsidian": "1.13.1",
    "oxlint": "1.86.0",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "vue-tsc": "3.3.11"
  },
  "dependencies": {
    "@nuxt/ui": "4.11.2",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-i18n": "11.4.12",
    "yaml": "2.9.1"
  },
  "description": "Developer workbench for declarative UI authoring, project setup, source generation and fixture-backed review.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.19.1 <13"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "make": "node bin/app make",
    "entities:check": "node scripts/makers/entities.mjs --check",
    "entities:catalog": "node scripts/makers/entities.mjs",
    "dev:ui": "vite --config configs/bundling/vite.harness.config.mjs --host 127.0.0.1 --open /harness/app/",
    "dev": "node scripts/dev/watch-local.mjs --no-local",
    "build": "node scripts/bundling/build.mjs",
    "build:local": "node scripts/dev/install-local.mjs",
    "test-build": "npm run build:local",
    "typecheck": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit --project configs/types/tsconfig.project.json",
    "test": "vitest run --config configs/testing/vitest.project.config.mjs",
    "test:watch": "vitest --config configs/testing/vitest.project.config.mjs",
    "test:coverage": "vitest run --coverage --config configs/testing/vitest.config.mjs",
    "harness:build": "vite build --config configs/bundling/vite.harness.config.mjs",
    "harness:preview": "vite preview --config configs/bundling/vite.harness.config.mjs --host 127.0.0.1 --port 4180 --strictPort",
    "test:e2e": "playwright test",
    "ui:gallery": "node scripts/ui/review-gallery.mjs --target clickdummy",
    "check:tokens": "node scripts/styles/check-tokens.mjs",
    "check:style-literals": "node scripts/styles/check-style-literals.mjs",
    "check:source": "node scripts/quality/check-source.mjs",
    "check:presentation": "node scripts/quality/check-presentation.mjs",
    "check:self-review": "node scripts/quality/self-review.mjs",
    "check:artifacts": "node scripts/quality/check-artifacts.mjs",
    "lint": "node scripts/quality/lint-source.mjs && eslint -c configs/lint/eslint.config.mjs src bin plugins templates/companion/runtime",
    "analyze": "fallow dead-code -c configs/quality/fallow.json",
    "verify": "node scripts/quality/verify.mjs",
    "help": "node scripts/help.mjs",
    "dev:local": "node scripts/dev/watch-local.mjs",
    "check:architecture": "node scripts/quality/check-architecture.mjs",
    "test:native": "node scripts/testing/check-native.mjs",
    "test:obsidian": "node scripts/testing/run-obsidian-tests.mjs",
    "dev:obsidian": "node scripts/dev/obsidian-dev.mjs",
    "check:analyzer": "node scripts/quality/check-analyzer.mjs",
    "check:maintainability": "node scripts/quality/check-maintainability.mjs",
    "check:security": "node scripts/security/audit.mjs",
    "check:dependencies": "node scripts/security/check-dependencies.mjs",
    "test:coverage:production": "vitest run --coverage --config configs/testing/vitest.production.config.mjs && node scripts/quality/coverage-inventory.mjs",
    "examples:remove": "node scripts/examples/cli.mjs",
    "check:projects": "node scripts/projects/projects.mjs check",
    "projects:sync": "node scripts/projects/projects.mjs sync",
    "check:docs-launchers": "node scripts/quality/check-docs-launchers.mjs",
    "events:catalog": "node scripts/events/catalog.mjs",
    "events:check": "node scripts/events/catalog.mjs --check",
    "app": "node bin/app",
    "new": "node bin/app new",
    "capabilities": "node scripts/operations/cli.mjs",
    "test:suites": "node scripts/testing/suites.mjs",
    "check": "node bin/app check",
    "check:fast": "node bin/app check --fast",
    "check:submission": "node bin/app check submission",
    "typecheck:sitemap": "node node_modules/typescript/bin/tsc --noEmit --project configs/types/tsconfig.sitemap.json",
    "maker": "node bin/app studio",
    "typecheck:maker": "node node_modules/typescript/bin/tsc --noEmit --project configs/types/tsconfig.maker.json",
    "test:plugins": "node scripts/testing/suites.mjs workbench-plugins",
    "check:plugins": "node scripts/quality/check-workbench-plugins.mjs",
    "test:framework": "vitest run --config configs/testing/vitest.config.mjs",
    "test:tdd": "vitest --config configs/testing/vitest.project.config.mjs \"tests/project/acceptance\"",
    "typecheck:project": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit --project configs/types/tsconfig.project.json",
    "test:ui-effects": "node scripts/testing/suites.mjs project:ui-effects",
    "build:clickdummy": "node bin/app clickdummy build",
    "doctor": "node bin/app doctor",
    "dev:preview": "node bin/app dev --profile preview",
    "airship:status": "node bin/app airship status",
    "airship:enable": "node bin/app airship enable",
    "airship:disable": "node bin/app airship disable",
    "airship:install": "node bin/app airship install",
    "airship:start": "node bin/app airship start",
    "airship:doctor": "node bin/app airship doctor",
    "test:e2e:framework": "playwright test --config configs/testing/playwright.config.ts",
    "test:ui-quality": "playwright test tests/e2e/ui-quality.spec.ts",
    "test:project": "node scripts/testing/suites.mjs project project:ui-effects",
    "verify:artifacts": "npm run build && npm run test:ui-effects && npm run testdata:check",
    "verify:project": "npm run check && npm run verify:artifacts",
    "testdata:check": "node scripts/test-data/verify.mjs",
    "testdata:plan": "node scripts/test-data/cli.mjs plan",
    "testdata:apply": "node scripts/test-data/cli.mjs apply",
    "testdata:reset-plan": "node scripts/test-data/cli.mjs reset-plan",
    "testdata:reset": "node scripts/test-data/cli.mjs reset",
    "testdata:serve": "node scripts/test-data/cli.mjs serve"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "vue-demi@0.14.10": true,
    "fsevents": false
  },
  "overrides": {
    "fontless@0.2.1": {
      "esbuild": "0.28.2"
    }
  },
  "packageManager": "npm@11.19.1",
  "author": "Luis Mendez"
}
