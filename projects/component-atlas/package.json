{
  "name": "component-atlas",
  "version": "2.0.0",
  "private": true,
  "description": "Component Atlas: define the building blocks. A self-contained Obsidian Product Family browser prototype (Vue 3 + Nuxt UI shell around the Component Atlas editor).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/package.mjs",
    "test": "node --test tests/protocol.test.mjs",
    "test:e2e": "node tests/browser.mjs",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@nuxt/ui": "4.11.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.142",
    "@vitejs/plugin-vue": "6.0.10",
    "playwright": "1.64.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4"
  }
}
