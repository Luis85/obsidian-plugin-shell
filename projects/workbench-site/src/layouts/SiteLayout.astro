---
import project from '../../workbench.project.json';
import { href } from '../lib/collections';
import '../styles/site.css';

interface Props { title?: string; description?: string }
const { title, description = project.summary } = Astro.props;
const pageTitle = title ? `${title} | ${project.title}` : project.title;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-title" href={href('/')}>{project.title}</a>
        <slot name="header" />
      </div>
    </header>
    <main id="main" class="container" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>Built with Astro from Obsidian Bases collections.</p>
      </div>
    </footer>
  </body>
</html>
