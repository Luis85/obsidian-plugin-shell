{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Shell CLI user manual",
  "tsconfig": "./tsconfig.json",
  "entryPoints": ["../framework/catalog.ts", "../framework/help-text.ts", "../framework/contracts.ts", "../compiler/domain/contracts.ts", "../compiler/domain/diagnostics.ts"],
  "readme": "../../docs/user-manual/shell-cli/index.md",
  "projectDocuments": [
    "../../docs/user-manual/shell-cli/getting-started.md",
    "../../docs/user-manual/shell-cli/design-and-generation.md",
    "../../docs/user-manual/shell-cli/development-and-testing.md",
    "../../docs/user-manual/shell-cli/automation-and-safety.md",
    "../../docs/user-manual/shell-cli/maintenance-and-release.md",
    "../../docs/user-manual/shell-cli/optional-integrations.md",
    "../../docs/user-manual/shell-cli/troubleshooting.md",
    "../../docs/user-manual/shell-cli/documentation-authoring.md",
    "../../docs/user-manual/shell-cli/application-documentation.md",
