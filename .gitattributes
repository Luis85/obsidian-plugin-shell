# Hash-verified inputs (starter catalog, example ownership manifest, templates,
# fixtures) are compared byte-for-byte after checkout. Pin LF on every platform so
# a Windows autocrlf checkout cannot turn a reviewed SHA-256 into a false mismatch.
* text=auto eol=lf

# Retained evidence keeps its committed bytes exactly as recorded.
docs/_archive/testing/evidence/** -text
docs/_archive/project-setup/evidence/** -text

# Binary assets never receive end-of-line normalization.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.tgz binary

# Standalone projects (projects/README.md) and their synced workflows are not part of
# the shell's source archives; each project ships from its own folder.
projects/** export-ignore
# Byte-exact like the project's own repository (generation receipts hash these bytes);
# a project may add its own .gitattributes, which takes precedence inside its folder.
projects/** -text
.github/workflows/projects--* export-ignore
